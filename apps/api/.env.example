APP_NAME=Airbeeps API
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/v1
LOG_LEVEL=INFO
LOG_JSON=false
DOCS_ENABLED=true
REQUEST_TIMEOUT_SECONDS=30
AIRBEEPS_RAG_TOP_K=5
AIRBEEPS_RAG_CHUNK_SIZE=1200
AIRBEEPS_RAG_CHUNK_OVERLAP=200
AIRBEEPS_RUNTIME_TOOL_MAX_ITERATIONS=4
AIRBEEPS_RUNTIME_HTTP_TIMEOUT_SECONDS=8
AIRBEEPS_WORKSPACE_REQUESTS_PER_MINUTE=60
AIRBEEPS_LLM_ESTIMATED_COST_PER_1K_TOKENS=0.001
AIRBEEPS_MEMORY_TOP_K=4
DB_ECHO=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=datasets
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=
LLM_API_KEY=your-provider-api-key
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
CHAT_SYSTEM_PROMPT=You are Airbeeps, an AI assistant helping users inside their workspace.
CHAT_CONTEXT_WINDOW_MESSAGES=20
